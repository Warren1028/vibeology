# Copy this file to .env (local) and set the same names in Vercel's Environment Variables.
# Never commit real values.

# Supabase: Project Settings → Database → Connection string → Transaction pooler (port 6543).
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<pooler-host>:6543/postgres

# Password for the staff admin at /admin. Use a long, unique one.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional but needed for the AI receptionist to answer and book. Without it, Vi answers basics only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local development only (Vercel ignores this).
PORT=3000
